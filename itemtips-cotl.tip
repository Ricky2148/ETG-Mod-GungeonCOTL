{
  "metadata": {
    "name": "Gungeon Cult of the Lamb",
    "version": "1.0.1",
    "url": ""
  },
  "items": {
    "gungeoncotl:red_crown": {
      "name": "Red Crown",
      "notes": "Gains EXP from killing enemies equal to their HP, spawns a selection of items upon level up"
    },

    "gungeoncotl:ascend_gun_ritual": {
      "name": "Ascend Gun Ritual",
      "notes": "Buffs your current gun with various buffs"
    },
    "gungeoncotl:sacrifice_of_the_gun": {
      "name": "Sacrifice of the Gun",
      "notes": "Trade your current gun for a random gun of higher rarity. +1 Curse on use"
    },
    "gungeoncotl:feasting_ritual": {
      "name": "Feasting Ritual",
      "notes": "Fully heals the player and +1 curse on use"
    },
    "gungeoncotl:ritual_of_enrichment": {
      "name": "Ritual of Enrichment",
      "notes": "Spawn in casings on use. Can roll bronze, silver, mix, or gold. Chance improves with coolness."
    },
    "gungeoncotl:rite_of_wrath": {
      "name": "Rite of Wrath",
      "notes": "Grants a 20 minute buff that gives increased damage and fire rate. Gradually increases your curse until the buff expires"
    },

    "gungeoncotl:doctrine_of_materialism": {
      "name": "Doctrine of Materialism",
      "notes": "Decreases shop prices by 5% with each purchase"
    },
    "gungeoncotl:doctrine_of_sin": {
      "name": "Doctrine of Sin",
      "notes": "Spawns a free chest, gives +2 curse"
    },
    "gungeoncotl:doctrine_of_sustenance": {
      "name": "Doctrine of Sustenance",
      "notes": "Healing has a chance to trigger an extra heal, free casings, or restore ammo"
    },
    "gungeoncotl:doctrine_of_law_and_order": {
      "name": "Doctrine of Law & Order",
      "notes": "All enemies -10% HP"
    },

    "gungeoncotl:heart_of_the_faithful_i": {
      "name": "Heart of the Faithful I",
      "notes": "+1 Blank per floor"
    },
    "gungeoncotl:heart_of_the_faithful_ii": {
      "name": "Heart of the Faithful II",
      "notes": "+1 Blank per floor, +1 Armor per floor"
    },
    "gungeoncotl:heart_of_the_faithful_iii": {
      "name": "Heart of the Faithful III",
      "notes": "+1 Blank per floor, +1 Armor per floor, +1 Heart"
    },
    "gungeoncotl:heart_of_the_faithful_iv": {
